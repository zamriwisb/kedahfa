---
import type { Team } from '../lib/content';
import type { TableEntry } from '../lib/standings';

interface Props {
  table: TableEntry[];
  teamsBySlug: Map<string, Team>;
  clubSlug: string;
  compact?: boolean;
}

const { table, teamsBySlug, clubSlug, compact = false } = Astro.props;

/**
 * Every cell in the club's own row shares the same solid-red, white-text,
 * rounded-ends treatment, so it is built once here rather than repeated per
 * column. `border-separate` (set on the table below) is required for the
 * `first`/`last` rounding to render — with the default `border-collapse`,
 * adjoining cells share border edges and a radius on one cell's edge has
 * nothing to round against.
 */
/**
 * NOTE for callers: any COLOUR utility passed in `extra` must be guarded on
 * `!isClub`. The club-row treatment below sets its own text colour, and two
 * competing `text-*` utilities on one element are resolved by CSS source
 * order, not by the order they appear in the class attribute — so an
 * unguarded one can silently win and render the cell unreadable.
 */
function cellClass(isClub: boolean, extra: string): string {
  return [
    extra,
    'border-b border-(--color-line)',
    // Bold weight, not just the tint: WCAG 1.4.1 forbids conveying meaning
    // by colour alone, so every cell in the club's row carries the same
    // redundant visual cue (bold) that a colourblind or low-vision reader
    // can perceive even without the red band. The sr-only marker below
    // gives screen reader users the equivalent cue.
    isClub &&
      'border-transparent bg-(--color-action) font-semibold text-(--color-text-invert) first:rounded-l-(--radius-card) last:rounded-r-(--radius-card)',
  ]
    .filter(Boolean)
    .join(' ');
}
---

<div class="overflow-hidden rounded-(--radius-card) bg-(--color-surface) shadow-sm">
  <!--
    The wrapper scrolls horizontally on narrow viewports, so it needs to be
    keyboard reachable — a scrollable region a mouse can pan but a keyboard
    cannot fails WCAG 2.1.1 (axe rule: scrollable-region-focusable).
  -->
  <div class="overflow-x-auto p-4 sm:p-6" tabindex="0" role="region" aria-label="League standings">
    <!--
      font-display is set once here rather than per cell: the table previously
      carried it on the header row, the team name and the Pts column only, so
      the position number and every other numeric column fell back to the body
      face and the table mixed Barlow Condensed with Inter. tabular-nums keeps
      the numeric columns from shifting width between values once real results
      replace the pre-season zeros.
    -->
    <table
      class="w-full min-w-[32rem] border-separate border-spacing-0 text-sm font-display tabular-nums"
    >
      <caption class="sr-only">League standings</caption>
      <thead>
        <tr class="text-left text-xs tracking-widest text-(--color-text-muted)">
          <!--
            pl-3 matches the body's first cell so the column stays aligned.
            The body needs it because the club row's red band starts at that
            cell's edge — without the inset the position number sits flush
            against the rounded corner.
          -->
          <th scope="col" class="border-b border-(--color-line) py-2 pl-3 pr-2">#</th>
          <th scope="col" class="border-b border-(--color-line) py-2 pr-2">Team</th>
          <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">P</th>
          {
            !compact && (
              <>
                <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">W</th>
                <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">D</th>
                <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">L</th>
                <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">GF</th>
                <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">GA</th>
              </>
            )
          }
          <th scope="col" class="border-b border-(--color-line) py-2 pr-2 text-center">GD</th>
          <th scope="col" class="border-b border-(--color-line) py-2 text-center text-(--color-brand)">
            Pts
          </th>
        </tr>
      </thead>

      <tbody>
        {
          table.map((entry) => {
            const isClub = entry.team === clubSlug;
            return (
              <tr>
                <td
                  class={cellClass(
                    isClub,
                    `py-3 pl-3 pr-2 ${isClub ? '' : 'text-(--color-text-muted)'}`,
                  )}
                >
                  {entry.position}
                </td>
                <th
                  scope="row"
                  class={cellClass(isClub, `py-3 pr-2 text-left ${isClub ? '' : 'font-normal'}`)}
                >
                  <span class="flex items-center gap-2">
                    <img
                      src={teamsBySlug.get(entry.team)?.crest}
                      alt=""
                      width="20"
                      height="20"
                      aria-hidden="true"
                      class="h-5 w-5 object-contain"
                    />
                    <span class="truncate">{entry.name}</span>
                    {/*
                      The club's row is never distinguished by colour alone
                      (WCAG 1.4.1): the bold weight above and this sr-only
                      marker both carry the same meaning for anyone who
                      cannot perceive the red band.
                    */}
                    {isClub && <span class="sr-only">(your club)</span>}
                  </span>
                </th>
                <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>{entry.played}</td>
                {!compact && (
                  <>
                    <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>{entry.won}</td>
                    <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>{entry.drawn}</td>
                    <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>{entry.lost}</td>
                    <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>{entry.goalsFor}</td>
                    <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>{entry.goalsAgainst}</td>
                  </>
                )}
                <td class={cellClass(isClub, 'py-3 pr-2 text-center')}>
                  {entry.goalDifference > 0 ? `+${entry.goalDifference}` : entry.goalDifference}
                </td>
                <td
                  class={cellClass(
                    isClub,
                    `py-3 text-center ${isClub ? '' : 'text-(--color-brand)'}`,
                  )}
                >
                  {entry.points}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</div>
