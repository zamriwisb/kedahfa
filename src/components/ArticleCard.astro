---
import type { Article } from '../lib/content';
import { formatArticleDate } from '../lib/dates';

interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;

const CATEGORY_LABELS: Record<Article['category'], string> = {
  'match-report': 'Match Report',
  club: 'Club',
  transfer: 'Transfer',
  academy: 'Academy',
};
---

<article class="group clip-corner relative overflow-hidden bg-(--color-brand-ink)" data-category={article.category}>
  <a href={`/news/${article.slug}`} class="relative block h-full !min-h-0">
    <img
      src={article.image}
      alt={article.imageAlt}
      width={featured ? 800 : 400}
      height={featured ? 500 : 320}
      loading="lazy"
      decoding="async"
      class:list={[
        'w-full object-cover transition duration-300 group-hover:scale-105',
        featured ? 'aspect-[4/3] sm:aspect-[16/10]' : 'aspect-[4/3]',
      ]}
    />

    {
      /*
       * The gradient overlay sits above the photo but the `<article>` root
       * carries an explicit solid bg-(--color-brand-ink) too — axe's
       * contrast check resolves the effective background from the nearest
       * ancestor's CSS background-color, not from this absolutely
       * positioned image/gradient, so the text below needs that solid
       * fallback to stay measurably AA-safe.
       */
    }
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-(--color-brand-ink) via-(--color-brand-ink)/45 to-transparent"
    />

    <div class="absolute inset-x-0 bottom-0 p-4">
      <p class="text-xs text-(--color-text-invert-muted) font-display">
        <time datetime={article.date.toISOString()}>{formatArticleDate(article.date)}</time>
      </p>
      <h3
        class:list={[
          'mt-1 leading-tight text-(--color-text-invert)',
          featured ? 'text-xl sm:text-2xl' : 'text-base sm:text-lg',
        ]}
      >
        {article.title}
      </h3>
      <p class="mt-2 text-xs tracking-widest text-(--color-accent) font-display">
        {CATEGORY_LABELS[article.category]}
      </p>
    </div>
  </a>
</article>
