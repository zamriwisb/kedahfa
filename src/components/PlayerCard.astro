---
import type { Player } from '../lib/squad';

interface Props {
  player: Player;
}
const { player } = Astro.props;
---

<a
  href={`/squad/${player.id}`}
  class="clip-corner group relative block !min-h-0 overflow-hidden bg-(--color-surface)"
>
  <div class="relative overflow-hidden bg-(--color-brand-ink)">
    <img
      src={player.photo}
      alt={`${player.name}, ${player.position}`}
      width="300"
      height="360"
      loading="lazy"
      decoding="async"
      class="aspect-[5/6] w-full object-cover transition duration-300 group-hover:scale-105"
    />

    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-3 right-1 text-7xl leading-none text-(--color-text-invert)/20 font-display sm:text-8xl"
    >
      {player.number}
    </span>
  </div>

  <div class="p-3">
    <p class="text-lg leading-tight font-display">{player.name}</p>
    <p class="mt-0.5 text-xs tracking-widest text-(--color-text-muted) font-display">
      {player.position}
    </p>
  </div>
</a>
