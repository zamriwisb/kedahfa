---
import type { Team } from '../lib/content';
import type { Hero } from '../lib/fixtures';
import { formatKickoffTime, formatMatchDate } from '../lib/dates';

interface Props {
  hero: Hero;
  teamsBySlug: Map<string, Team>;
}

const { hero, teamsBySlug } = Astro.props;
---

{
  hero && (
    <section class="relative isolate flex min-h-[420px] flex-col justify-end overflow-hidden bg-(--color-brand-deep) sm:min-h-[540px] lg:min-h-[620px]">
      <img
        src="/images/news/placeholder.svg"
        alt=""
        aria-hidden="true"
        width="1600"
        height="900"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
      {
        /*
         * The section keeps its own solid --color-brand-deep background as a
         * fallback behind the photo. axe's contrast check resolves the
         * effective background colour from the nearest ancestor's CSS
         * background-color, not from this absolutely-positioned image or
         * gradient — that mismatch (a dark section background-colour, but no
         * explicit text colour) is exactly what produced 1.42:1 here before.
         * Every text node below now sets an explicit invert colour, so it
         * stays AA-safe against that solid fallback regardless of how the
         * photo itself renders.
         */
      }
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-gradient-to-t from-(--color-brand-ink) via-(--color-brand-ink)/60 to-transparent"
      />

      <div class="relative mx-auto w-full max-w-6xl px-(--spacing-gutter) pb-8 pt-24 sm:pb-12">
        <p class="text-sm text-(--color-text-invert) font-display">
          {formatMatchDate(hero.match.date)}
        </p>

        <h1 class="mt-2 max-w-3xl text-5xl leading-[0.95] text-(--color-text-invert) sm:text-7xl lg:text-8xl">
          {teamsBySlug.get(hero.match.home)?.shortName}
          <span class="mx-2 text-(--color-action)">
            {hero.match.score ? `${hero.match.score.home} - ${hero.match.score.away}` : 'v'}
          </span>
          {teamsBySlug.get(hero.match.away)?.shortName}
        </h1>

        <p class="mt-3 text-sm text-(--color-text-invert-muted)">
          {hero.match.competition} &middot; {formatMatchDate(hero.match.date)}
          {hero.kind === 'fixture' && ` · ${formatKickoffTime(hero.match.date)}`}
          &middot; {hero.match.venue}
        </p>

        {hero.match.report && (
          <a
            href={`/news/${hero.match.report}`}
            class="clip-corner mt-6 inline-flex bg-(--color-action) px-6 text-sm tracking-widest text-(--color-text-invert) font-display"
          >
            Match Report
          </a>
        )}
      </div>
    </section>
  )
}
