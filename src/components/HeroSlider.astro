---
import type { Slide } from '../lib/slides';

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
const total = slides.length;
---

{
  /*
   * The track is a scroll-snap container rather than a JS-swapped stack of
   * absolutely positioned slides. Touch swipe, momentum and keyboard
   * scrolling then come from the browser, and the script in this file only
   * *adds* autoplay and indicator syncing on top. If that script fails to
   * run, this is still a working gallery instead of a dead single frame.
   *
   * The section keeps its own solid --color-brand-ink background behind the
   * photo, and every text node below sets an explicit invert colour. axe
   * resolves a text node's effective background from the nearest ancestor's
   * CSS background-color — never from an absolutely-positioned image or
   * gradient — so a dark section with no explicit text colour reads as a
   * contrast failure (measured 1.42:1 in the HeroPanel this replaces).
   */
}
{
  total > 0 && (
    <section
      class="hero-slider relative isolate bg-(--color-brand-ink)"
      aria-roledescription="carousel"
      aria-label="Featured"
    >
      <div
        class="hero-slider__track overflow-x-auto overscroll-x-contain snap-x snap-mandatory"
        tabindex={total > 1 ? 0 : undefined}
        role="region"
        aria-label="Featured slides"
      >
        <ul class="flex">
          {slides.map((slide, index) => {
            const externalRel = slide.href?.startsWith('https://') ? 'noopener' : undefined;

            return (
              <li
                class="hero-slider__slide relative flex min-h-[420px] w-full shrink-0 snap-start flex-col justify-end overflow-hidden sm:min-h-[540px] lg:min-h-[620px] xl:chevron-texture xl:grid xl:min-h-[max(440px,calc(100vw/3.5))] xl:bg-(--color-brand-deep)"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${total}`}
              >
                {
                  /*
                   * Below `xl` the photo lies under the copy and the scrims
                   * make it legible. At `xl` it stops being a backdrop and
                   * becomes the third grid column, so it needs no scrim at
                   * all — and `static` is what releases it from `inset-0`
                   * without having to unset four offsets.
                   */
                }
                <div class="absolute inset-0 -z-10 xl:relative xl:inset-auto xl:z-auto xl:col-start-3 xl:row-start-1">
                  {
                    /*
                     * `object-top` exists for the one source that cannot be
                     * cut to 16:9 — league-confirmed's poster is 1350x1688,
                     * portrait — where a wide box centred on the image lands
                     * below the poster's own title. It stops at `xl`: the
                     * split column is ~1.8:1, close enough to the 16:9 the
                     * other slides are cut to that centring is right again
                     * and top-anchoring would push subjects out of frame.
                     *
                     * A slide that sets `objectPosition` overrides both, at
                     * every width, because it is inline. That is the intent:
                     * the field exists for a source whose subject is not in
                     * the middle, and such a source is off-centre at 390px
                     * and at 2560px alike. It stays off the other slides —
                     * absent the field there is no style attribute at all,
                     * so the classes above keep describing them.
                     */
                  }
                  <img
                    src={slide.image}
                    alt={slide.imageAlt}
                    width="1600"
                    height="900"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    class="h-full w-full object-cover lg:object-top xl:absolute xl:inset-0 xl:object-center"
                    style={slide.objectPosition ? `object-position: ${slide.objectPosition}` : undefined}
                  />
                  {
                    /*
                     * Two stacked layers, not one gradient: the ramp alone
                     * left the headline sitting where the scrim was only
                     * ~76% opaque, measuring ~3.2:1 for white text against a
                     * bright daytime stadium photo — a WCAG 1.4.3 failure.
                     * The flat 40% layer puts a floor of darkening across the
                     * whole photo regardless of what is bright in it, and the
                     * steeper ramp on top of that floor is what keeps the
                     * text AA-legible. axe cannot verify this: it resolves a
                     * text node's effective background from the nearest
                     * ancestor's CSS background-color, never from a photo or
                     * a gradient, so this pair has to be checked by eye
                     * against real photography.
                     *
                     * Both go at `xl`, where the copy moves onto solid
                     * brand-deep and darkening the photo would only mute it.
                     */
                  }
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-(--color-brand-ink)/40 xl:hidden"
                  />
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 bg-gradient-to-t from-(--color-brand-ink) via-(--color-brand-ink)/80 to-transparent xl:hidden"
                  />
                </div>

                {
                  /*
                   * `page-shell` spelled out rather than used: at `xl` this
                   * sits in grid column 2, and column 1 is exactly the shell's
                   * own left inset — so the copy keeps the page's left edge
                   * while the panel itself runs to the viewport edge. Wearing
                   * the class here would also make this the first
                   * `main .page-shell` on the homepage at a width the shell
                   * no longer describes.
                   */
                }
                <div class="relative mx-auto w-full max-w-(--container-6xl) px-(--spacing-gutter) pb-20 pt-24 xl:col-start-2 xl:row-start-1 xl:mx-0 xl:max-w-none xl:self-center xl:px-0 xl:py-14">
                  {slide.eyebrow && (
                    <p class="text-sm tracking-widest text-(--color-text-invert) font-display">
                      {slide.eyebrow}
                    </p>
                  )}

                  {/*
                    The measure stops growing at `xl` — it is a fixed 30rem
                    column from there up — so the headline stops growing with
                    it. Stepping to 6xl at 2xl only put more type in the same
                    width and stranded "TOP-" at the end of a line.
                  */}
                  <h2 class="mt-2 max-w-3xl text-balance text-4xl leading-[0.95] text-(--color-text-invert) sm:text-6xl lg:text-7xl xl:text-5xl">
                    {slide.href ? (
                      <a
                        href={slide.href}
                        rel={externalRel}
                        class="text-(--color-text-invert) transition-colors hover:text-(--color-accent)"
                      >
                        {slide.title}
                      </a>
                    ) : (
                      slide.title
                    )}
                  </h2>

                  {slide.cta && slide.href && (
                    <a
                      href={slide.href}
                      rel={externalRel}
                      class="clip-corner mt-6 inline-flex bg-(--color-action) px-6 text-sm tracking-widest text-(--color-text-invert) transition-colors font-display hover:bg-(--color-action-deep)"
                    >
                      {slide.cta}
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>

      {total > 1 && (
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10">
          {/* Right of the copy below `xl`, under it once the copy has a panel. */}
          <div class="page-shell flex justify-end pb-4 xl:justify-start">
            <div class="pointer-events-auto flex items-center gap-4" role="group" aria-label="Slideshow controls">
              {
                /*
                 * Rendered hidden: without the script, or under
                 * prefers-reduced-motion, autoplay never starts, so a visible
                 * pause control would claim a mechanism that does not exist.
                 * The script removes `hidden` only once it actually starts
                 * the timer.
                 */
              }
              <button type="button" class="hero-slider__toggle" aria-label="Pause slideshow" hidden>
                <svg
                  class="hero-slider__toggle-icon-pause h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <rect x="4" y="3" width="4" height="14" />
                  <rect x="12" y="3" width="4" height="14" />
                </svg>
                <svg
                  class="hero-slider__toggle-icon-play hidden h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 3l12 7-12 7V3Z" />
                </svg>
              </button>
              <div class="flex gap-2" role="group" aria-label="Choose a slide">
                {slides.map((_, index) => (
                  <button
                    type="button"
                    class="hero-slider__dot justify-center px-1"
                    data-slide-to={index}
                    aria-label={`Go to slide ${index + 1}`}
                    aria-current={index === 0 ? 'true' : undefined}
                  >
                    <span aria-hidden="true" />
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}
    </section>
  )
}

<style>
  /*
   * The desktop split, and the only rule here that carries real geometry.
   *
   * A fixed height fights a fixed source. The slide box used to stay 620px
   * tall however wide the viewport got, so a 16:9 photo met a 2.06:1 slot at
   * 1280 and a 3.10:1 slot at 1920 — `object-cover` answered by throwing away
   * 43% of the image's height, meaning the bigger the monitor, the harsher the
   * crop. The three columns below undo that:
   *
   *   1  the page shell's own left inset, so the copy keeps the page's left
   *      edge without the panel having to stop at the shell's right one;
   *   2  a fixed 30rem measure, so the headline never reflows with viewport;
   *   3  everything left over, which is where the photo goes.
   *
   * Column 3 therefore absorbs all the extra width while `aspect-ratio` grows
   * the height alongside it, holding the photo box between 1.63:1 and 1.89:1
   * from 1280 through 2560 against a 16:9 source — a worst case of ~9%, down
   * from 43%. `min-height` floors it at the narrow end, where the ratio alone
   * would give a 366px-tall hero.
   *
   * `100%` resolves against the grid container, which is the same box
   * `.page-shell` centres in — using `100vw` would include the scrollbar and
   * put the copy ~7px off the crest above it.
   */
  @media (width >= 80rem) {
    .hero-slider__slide {
      grid-template-columns:
        max(var(--spacing-gutter), calc((100% - var(--container-6xl)) / 2 + var(--spacing-gutter)))
        minmax(0, 30rem)
        minmax(0, 1fr);
    }
  }

  /*
   * Two things Tailwind utilities cannot express cleanly, kept together here:
   * hiding the track's scrollbar (the dashes are the affordance) and styling
   * the dash from its own aria-current, so the DOM attribute the script sets
   * is the single source of truth for which dash is active.
   */
  .hero-slider__track {
    scrollbar-width: none;
  }

  .hero-slider__track::-webkit-scrollbar {
    display: none;
  }

  .hero-slider__dot span {
    display: block;
    height: 3px;
    width: 2rem;
    background-color: rgb(255 255 255 / 45%);
    transition: background-color 150ms ease;
  }

  .hero-slider__dot[aria-current='true'] span {
    background-color: var(--color-accent);
  }

  /* Same colour and visual weight as an unselected dash (45% opacity of
     --color-text-invert), brightening to full opacity on hover/focus so the
     control stays discoverable without introducing a new colour. */
  .hero-slider__toggle {
    color: var(--color-text-invert);
    opacity: 45%;
    transition: opacity 150ms ease;
  }

  .hero-slider__toggle:hover,
  .hero-slider__toggle:focus-visible {
    opacity: 100%;
  }
</style>

<script>
  const AUTOPLAY_MS = 6000;

  for (const root of document.querySelectorAll<HTMLElement>('.hero-slider')) {
    const track = root.querySelector<HTMLElement>('.hero-slider__track');
    const slides = [...root.querySelectorAll<HTMLElement>('.hero-slider__slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.hero-slider__dot')];
    const toggle = root.querySelector<HTMLButtonElement>('.hero-slider__toggle');
    const toggleIcons = toggle && {
      pause: toggle.querySelector<SVGElement>('.hero-slider__toggle-icon-pause'),
      play: toggle.querySelector<SVGElement>('.hero-slider__toggle-icon-play'),
    };

    // One slide needs no timer, no observer and no listeners.
    if (!track || slides.length < 2) continue;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    // Reduced motion means autoplay never starts in the first place.
    let stopped = reduceMotion;

    const goTo = (index: number) => {
      current = (index + slides.length) % slides.length;
      // Every slide is exactly the width of the track, so the offset is a
      // multiplication — no offsetLeft arithmetic that depends on which
      // ancestor happens to be the offsetParent.
      track.scrollTo({
        left: track.clientWidth * current,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };

    const pause = () => {
      if (timer === null) return;
      clearInterval(timer);
      timer = null;
    };

    // The one place that owns both the `stopped` flag and the toggle
    // button's presentation, so every call site that ends or resumes
    // autoplay updates the button the same way instead of duplicating it.
    const setStopped = (value: boolean) => {
      stopped = value;
      if (!toggle || !toggleIcons) return;
      toggle.setAttribute('aria-label', value ? 'Play slideshow' : 'Pause slideshow');
      toggleIcons.pause?.classList.toggle('hidden', value);
      toggleIcons.play?.classList.toggle('hidden', !value);
    };

    const start = () => {
      if (stopped || timer !== null) return;
      timer = setInterval(() => goTo(current + 1), AUTOPLAY_MS);
      // Only unhidden once autoplay actually starts: without this script, or
      // under prefers-reduced-motion, this line never runs, so the control
      // never appears for a slider that does not move.
      if (toggle) toggle.hidden = false;
    };

    // Deliberate interaction ends autoplay for this page view. Pausing would
    // not be enough: a slide must never be yanked away from someone who
    // chose it and is reading it.
    const stop = () => {
      setStopped(true);
      pause();
    };

    toggle?.addEventListener('click', () => {
      if (stopped) {
        setStopped(false);
        start();
      } else {
        stop();
      }
    });

    // Observing the result rather than the cause: whatever moved the track —
    // autoplay, a swipe, the keyboard, the scrollbar — the dashes follow.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = slides.indexOf(entry.target as HTMLElement);
          if (index < 0) continue;

          current = index;
          for (const [position, dot] of dots.entries()) {
            if (position === index) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          }
        }
      },
      { root: track, threshold: 0.6 },
    );
    for (const slide of slides) observer.observe(slide);

    for (const dot of dots) {
      dot.addEventListener('click', () => {
        stop();
        goTo(Number(dot.dataset.slideTo));
      });
    }

    track.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      stop();
      goTo(current + (event.key === 'ArrowRight' ? 1 : -1));
    });

    // Touch, wheel and drag are the honest signals that the visitor is
    // driving. A plain 'scroll' listener cannot be used here — it fires for
    // this script's own scrollTo() as well, which would stop autoplay one
    // tick after it started.
    for (const eventName of ['pointerdown', 'touchstart'] as const) {
      track.addEventListener(eventName, stop, { passive: true });
    }

    // A vertical wheel is the visitor scrolling the PAGE with the cursor
    // resting over the hero — not an interaction with the slider. Only a
    // sideways gesture means they are driving the track itself.
    track.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
        stop();
      },
      { passive: true },
    );

    root.addEventListener('pointerenter', pause);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause();
      else start();
    });

    start();
  }
</script>
