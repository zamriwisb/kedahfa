---
import CtaButton from './CtaButton.astro';
import MobileNav from './islands/MobileNav.astro';
import { loadSiteData } from '../lib/content';

const { club } = await loadSiteData();
const currentPath = Astro.url.pathname;

const links = [
  { href: '/news', label: 'News' },
  { href: '/squad', label: 'Squad' },
  { href: '/fixtures', label: 'Fixtures' },
  { href: '/standings', label: 'Standings' },
  { href: '/club', label: 'Club' },
  { href: '/contact', label: 'Contact' },
];

const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

// Minimal inline icon set for the socials the club data actually lists.
// Anything not recognised falls back to a plain link glyph rather than
// silently rendering nothing.
const socialIcons: Record<string, string> = {
  facebook:
    'M13.5 9H15V6.5h-1.5C11.6 6.5 10.5 7.6 10.5 9.5V11H9v2.5h1.5V19h2.5v-5.5H15L15.5 11h-2V9.5c0-.3.2-.5.5-.5Z',
  instagram:
    'M8 4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Zm4 4.5A3.5 3.5 0 1 0 12 15.5 3.5 3.5 0 0 0 12 8.5Zm0 2A1.5 1.5 0 1 1 12 13.5 1.5 1.5 0 0 1 12 10.5ZM16.75 6.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z',
  x: 'M6 5l12 14M18 5 6 19',
  youtube:
    'M20.5 8.2s-.2-1.4-.8-2c-.7-.8-1.6-.8-2-.9C15 5 12 5 12 5h0s-3 0-5.7.3c-.4.1-1.3.1-2 .9-.6.6-.8 2-.8 2S3.3 9.9 3.3 11.5v1c0 1.6.2 3.3.2 3.3s.2 1.4.8 2c.7.8 1.7.7 2.1.8 1.5.2 6.6.3 6.6.3s3 0 5.7-.3c.4 0 1.3-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.3v-1c0-1.6-.2-3.3-.2-3.3ZM10 14.5v-5l4.5 2.5-4.5 2.5Z',
  tiktok:
    'M14.5 4h2.1c.2 1.6 1.2 2.9 3.4 3v2.2c-1.3 0-2.5-.4-3.4-1.1v5.4a4.6 4.6 0 1 1-4.6-4.6c.2 0 .4 0 .6.1v2.2a2.4 2.4 0 1 0 1.9 2.3V4Z',
  whatsapp:
    'M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.3A9 9 0 1 0 12 3Zm0 2a7 7 0 0 1 5.9 10.7l-.3.4.7 2.5-2.6-.7-.4.2A7 7 0 1 1 12 5Zm-2.7 3.2c-.2 0-.5 0-.7.3-.2.3-.9.8-.9 2s.9 2.3 1 2.5c.1.1 1.8 2.8 4.4 3.7 2.2.8 2.2.5 2.6.5.4 0 1.3-.5 1.5-1s.2-.9.1-1c-.1-.1-.3-.2-.5-.3l-1.7-.8c-.2-.1-.4-.2-.6.1l-.5.7c-.1.2-.3.2-.5.1-.3-.1-1.1-.4-2-1.3-.7-.7-1.2-1.5-1.4-1.8-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3 0-.5l-.8-1.8c-.1-.3-.3-.3-.5-.3Z',
  linkedin:
    'M6.5 8.5h2.7V18H6.5Zm1.4-4.2a1.6 1.6 0 1 1 0 3.1 1.6 1.6 0 0 1 0-3.1ZM11.5 8.5h2.6v1.3h.1c.4-.7 1.3-1.5 2.7-1.5 2.9 0 3.4 1.9 3.4 4.3V18h-2.7v-4.7c0-1.1 0-2.6-1.6-2.6-1.6 0-1.9 1.2-1.9 2.5V18h-2.6Z',
};
const defaultIcon = 'M4 12a8 8 0 1 1 16 0 8 8 0 0 1-16 0Zm4 0h8M12 4a12 12 0 0 1 0 16 12 12 0 0 1 0-16Z';
---

<header class="relative bg-(--color-brand)">
  <div class="relative mx-auto max-w-6xl px-(--spacing-gutter)">
    <div class="flex items-center justify-between gap-4 py-3">
      <a href="/" class="flex items-center gap-4 pl-28 sm:gap-5 sm:pl-32 lg:pl-36" aria-label={`${club.name} home`}>
        <span class="font-display text-xl leading-none text-(--color-text-invert) sm:text-2xl lg:text-3xl">
          {club.shortName} FA
        </span>
      </a>

      <ul class="flex items-center gap-4">
        {
          club.socials.map((social) => (
            <li>
              <a
                href={social.url}
                rel="me noopener"
                aria-label={social.platform}
                class="flex h-8 w-8 items-center justify-center text-(--color-text-invert) opacity-90 transition-opacity hover:opacity-100"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <path
                    d={socialIcons[social.platform.toLowerCase()] ?? defaultIcon}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* The crest hangs below both bars, overlapping the top and nav tiers. */}
    <a
      href="/"
      aria-label={`${club.name} home`}
      class="absolute left-(--spacing-gutter) top-2 z-20 block"
    >
      <img
        src="/images/teams/kedah.svg"
        alt={`${club.name} crest`}
        width="144"
        height="144"
        class="h-24 w-24 drop-shadow-md sm:h-28 sm:w-28 lg:h-36 lg:w-36"
      />
    </a>
  </div>

  <div class="bg-(--color-brand-deep)">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-(--spacing-gutter)">
      <div class="flex items-center">
        <div class="hidden shrink-0 sm:block sm:w-28 lg:w-36" aria-hidden="true"></div>

        <nav aria-label="Main navigation" class="hidden md:block">
          <ul class="flex items-center gap-1">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    class:list={[
                      'inline-flex border-b-2 px-3 text-sm tracking-wider font-display',
                      isCurrent(link.href)
                        ? 'border-(--color-accent) text-(--color-accent)'
                        : 'border-transparent text-(--color-text-invert)',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div class="flex items-center gap-3 py-2">
        <CtaButton href="/contact" label="Contact" />
        <MobileNav links={links} />
      </div>
    </div>
  </div>
</header>
