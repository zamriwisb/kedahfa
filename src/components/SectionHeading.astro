---
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  linkLabel?: string;
  /**
   * 1 for a page's primary heading, 2 for sections within a page. Index pages
   * use this component for their title, so without it every list route would
   * render an h2 as its highest heading and no h1 at all.
   */
  level?: 1 | 2;
  /**
   * Which surface this heading sits on. Gold text is only ever AA-compliant
   * on the brand greens, so the eyebrow (and the link, if any) switch to a
   * muted grey when the surrounding section is the light page.
   */
  on?: 'light' | 'green';
}
const { title, eyebrow, href, linkLabel = 'View all', level = 2, on = 'light' } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';

const eyebrowClass =
  on === 'green' ? 'text-(--color-gold)' : 'text-(--color-text-muted)';
const headingClass = on === 'green' ? 'text-(--color-text-invert)' : 'text-(--color-text)';
const linkClass =
  on === 'green'
    ? 'text-(--color-text-invert-muted) hover:text-(--color-text-invert)'
    : 'text-(--color-action) hover:text-(--color-action-deep)';
---

<div class="mb-8">
  {
    eyebrow && (
      <p class={`text-xs font-semibold uppercase tracking-[0.2em] ${eyebrowClass}`}>{eyebrow}</p>
    )
  }
  <div class="mt-1 flex flex-wrap items-end justify-between gap-4">
    <Heading class={`text-4xl sm:text-5xl ${headingClass}`}>{title}</Heading>
    {
      href && (
        <a href={href} class={`shrink-0 text-sm tracking-wider font-display ${linkClass}`}>
          {linkLabel}
        </a>
      )
    }
  </div>
  <div class="mt-4 h-1 w-16 bg-(--color-gold)"></div>
</div>
