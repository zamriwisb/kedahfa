---
import SocialIcon from './SocialIcon.astro';
import SponsorGrid from './SponsorGrid.astro';
import { loadSiteData } from '../lib/content';

const { club, sponsors } = await loadSiteData();
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Sport',
    links: [
      { href: '/news', label: 'News' },
      { href: '/squad', label: 'Squad' },
      { href: '/fixtures', label: 'Match Fixtures' },
      { href: '/standings', label: 'Standings' },
    ],
  },
  {
    heading: 'Our Club',
    links: [
      { href: '/club', label: 'Club History' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    heading: 'Info',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms & Conditions' },
    ],
  },
];
---

{/*
  No top margin. The footer used to clear itself from the page with mt-20,
  which worked while it followed a section on the light page background. It now
  opens on the brand green, so that margin renders as a grey band between two
  green surfaces. Every page already ends in its own bottom padding, so the
  footer can butt straight up against the content above it.
*/}
<footer class="text-(--color-text-invert)">
  {/*
    The partner band is the one light surface in the footer. The sections above
    it are already green — stacking a third green here made the whole page
    bottom read as one undifferentiated block. White separates the partners
    from both the page and the navigation beneath, and it keeps the brand
    yellow spent only on the column headings below.
  */}
  {
    sponsors.length > 0 && (
      <section class="bg-(--color-surface)" aria-labelledby="footer-partners">
        <div class="page-shell py-12">
          <h2 id="footer-partners" class="sr-only">
            Our partners
          </h2>
          <SponsorGrid sponsors={sponsors} />
        </div>
      </section>
    )
  }

  {/*
    Column gap beats row rhythm, in both directions. Stacked, the 48px gap-y
    separates the three lists more than the rows inside them; side by side, the
    40px gap-x does the same job. Get that ordering backwards and the headings
    stop owning the links beneath them.
  */}
  <div class="bg-(--color-brand-deep)">
    <nav
      aria-label="Footer"
      class="page-shell grid gap-x-10 gap-y-12 py-14 text-center sm:grid-cols-3"
    >
      {
        columns.map((column) => (
          <div>
            <h2 class="text-sm tracking-[0.2em] text-(--color-accent)">{column.heading}</h2>
            {/*
              The global 44px tap target is right for a thumb and far too loose
              for a list of eight secondary links: it wraps 17px of text in a
              44px box, so the rows drifted further apart than the columns did.
              Fine pointers get a 2rem row instead — still clear of the 24px
              WCAG 2.5.8 floor — and anything coarse keeps the full 44px.
            */}
            <ul class="mt-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-(--color-text-invert) transition-colors pointer-fine:min-h-8 hover:text-(--color-accent)"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  {/*
    The rule between the two dark bands is the brand green, not a token line
    colour: brand-deep and brand-ink are close enough that a hairline between
    them disappears, and the green reads as a deliberate divider rather than a
    seam.
  */}
  <div class="border-t-2 border-(--color-brand) bg-(--color-brand-ink)">
    <div class="page-shell flex flex-col items-center gap-6 py-10 text-center">
      <a href="/" aria-label={`${club.name} home`}>
        <img
          src="/images/teams/kedah.png"
          alt={`${club.name} crest`}
          width="793"
          height="853"
          class="h-16 w-auto"
        />
      </a>

      <ul class="flex flex-wrap items-center justify-center gap-3">
        {
          club.socials.map((social) => (
            <li>
              <a
                href={social.url}
                rel="me noopener"
                aria-label={social.platform}
                class="flex h-11 w-11 items-center justify-center rounded-(--radius-pill) border border-(--color-text-invert-muted) text-(--color-text-invert-muted) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)"
              >
                <SocialIcon platform={social.platform} class="h-4 w-4" />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="text-xs text-(--color-text-invert-muted)">
        &copy; {year} | {club.name} | All Rights Reserved
      </p>
    </div>
  </div>
</footer>
