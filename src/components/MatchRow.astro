---
import type { Team } from '../lib/content';
import { outcomeFor, type Match } from '../lib/fixtures';
import { formatKickoffTime, formatMatchDate } from '../lib/dates';
import MatchActions from './MatchActions.astro';

interface Props {
  match: Match;
  teamsBySlug: Map<string, Team>;
  clubSlug: string;
  /** Build time, used to decide whether this match can still be sold to. */
  now: Date;
  /** The next upcoming match is inverted to the brand green, per the reference. */
  highlight?: boolean;
}

const { match, teamsBySlug, clubSlug, now, highlight = false } = Astro.props;

const home = teamsBySlug.get(match.home);
const away = teamsBySlug.get(match.away);
const outcome = outcomeFor(match, clubSlug);

const OUTCOME_STYLES: Record<string, string> = {
  W: 'bg-(--color-win)',
  D: 'bg-(--color-draw)',
  L: 'bg-(--color-loss)',
};

const OUTCOME_LABELS: Record<string, string> = { W: 'Win', D: 'Draw', L: 'Loss' };
---

<div
  class:list={[
    'flex h-full w-full flex-col overflow-hidden rounded-(--radius-card) shadow-sm',
    highlight ? 'bg-(--color-brand-deep)' : 'bg-(--color-surface)',
  ]}
  data-competition={match.competition}
>
  <div
    class:list={[
      // A highlighted card had no header border at all, which made its
      // header — and so its crest row below — 1px shorter than every other
      // card's. Reserve the same 1px with a transparent border: borders
      // paint over the background (background-clip defaults to border-box),
      // so this stays invisible without hard-coding it to match whatever
      // colour the highlighted header happens to use today.
      'flex items-center justify-between gap-2 px-4 py-2 text-xs font-display tracking-wide border-b',
      highlight
        ? 'border-transparent bg-(--color-brand) text-(--color-text-invert)'
        : 'border-(--color-line) text-(--color-text-muted)',
    ]}
  >
    <span class:list={['font-semibold', !highlight && 'text-(--color-text)']}>
      {formatMatchDate(match.date)}
      {match.status !== 'postponed' && ` · ${formatKickoffTime(match.date)}`}
    </span>
    <span class="truncate pl-2">{match.competition}</span>
  </div>

  <div class="flex items-center justify-between gap-2 px-3 py-5">
    <div class="flex min-w-0 flex-1 flex-col items-center gap-2 text-center">
      <img src={home?.crest} alt="" width="40" height="40" aria-hidden="true" class="h-10 w-10 object-contain" />
      <span
        class:list={[
          'w-full min-h-9 text-sm leading-tight font-display',
          highlight ? 'text-(--color-text-invert)' : 'text-(--color-text)',
        ]}
      >
        {home?.name}
      </span>
    </div>

    <div class="flex shrink-0 flex-col items-center gap-1.5">
      {
        match.score ? (
          <span class="rounded-(--radius-card) bg-(--color-brand) px-3 py-1 text-lg leading-none text-(--color-text-invert) font-display">
            {match.score.home} : {match.score.away}
          </span>
        ) : match.status === 'postponed' ? (
          <span
            class:list={[
              'text-lg font-display',
              highlight ? 'text-(--color-text-invert-muted)' : 'text-(--color-text-muted)',
            ]}
          >
            P-P
          </span>
        ) : (
          <span
            class:list={[
              'text-2xl font-display',
              highlight ? 'text-(--color-text-invert-muted)' : 'text-(--color-text-muted)',
            ]}
          >
            VS
          </span>
        )
      }
      {
        outcome && (
          <span
            class:list={[
              // `relative` gives the sr-only span below a containing block
              // here rather than the initial containing block — see
              // MatchActions.astro's comment on its button anchor for why
              // that matters inside this same horizontally-scrolled
              // fixtures track. Do not drop this class.
              'relative flex h-5 w-5 items-center justify-center rounded-full text-[0.6rem] text-white',
              OUTCOME_STYLES[outcome],
            ]}
          >
            <span class="sr-only">{OUTCOME_LABELS[outcome]}</span>
            <span aria-hidden="true">{outcome}</span>
          </span>
        )
      }
    </div>

    <div class="flex min-w-0 flex-1 flex-col items-center gap-2 text-center">
      <img src={away?.crest} alt="" width="40" height="40" aria-hidden="true" class="h-10 w-10 object-contain" />
      <span
        class:list={[
          'w-full min-h-9 text-sm leading-tight font-display',
          highlight ? 'text-(--color-text-invert)' : 'text-(--color-text)',
        ]}
      >
        {away?.name}
      </span>
    </div>
  </div>

  <div
    class:list={[
      'mt-auto flex items-center justify-between gap-2 px-4 py-2 text-xs',
      highlight
        ? 'bg-(--color-brand-ink) text-(--color-text-invert-muted)'
        : 'bg-(--color-page) text-(--color-text-muted)',
    ]}
  >
    <span class="truncate">{match.venue}</span>
    {
      match.report && (
        <a
          href={`/news/${match.report}`}
          class:list={[
            'shrink-0 underline',
            highlight ? 'text-(--color-text-invert)' : 'text-(--color-brand)',
          ]}
        >
          Report
        </a>
      )
    }
  </div>

  <MatchActions match={match} clubSlug={clubSlug} now={now} highlight={highlight} />
</div>
