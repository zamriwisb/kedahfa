---
import '../styles/global.css';
/*
 * The @font-face rules live inside global.css, so the browser only discovers
 * these woff2 URLs after downloading and parsing that stylesheet — a second
 * serialized round trip before any real text can paint. Importing them with
 * ?url yields the hashed build path, which the preloads below hand to the
 * browser in the initial HTML instead. Only the latin subsets used above the
 * fold are preloaded (Inter for body copy, Barlow Condensed 700 for the
 * masthead and headings); the other subsets stay behind their unicode-range
 * and the 600 weight is footer-only.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import barlowLatin700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadSiteData } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;
const { club } = await loadSiteData();

const pageTitle = `${title} | ${club.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* crossorigin is required even same-origin: fonts are fetched in CORS
        mode, and without it the browser discards the preload and refetches. */}
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={barlowLatin700} crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${club.name} news`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="min-h-screen bg-(--color-page) text-(--color-text) antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-(--color-action) focus:px-4 focus:text-(--color-text-invert)"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
